<?xml version="1.0" encoding="utf-8"?>
<!--
  Certificats standard requis par le Google Fonts Provider (androidx.compose.ui.text.googlefonts)
  pour vérifier l'app com.google.android.gms qui sert les polices. Ce sont les empreintes
  publiques officielles documentées par Google pour les polices "downloadable" — identiques
  pour toutes les apps Android, aucune clé privée n'est nécessaire ici.
  Source : https://github.com/android/user-interface-samples (downloadable-fonts sample) /
  https://developer.android.com/develop/ui/views/text-and-emoji/downloadable-fonts
-->
<resources>
    <array name="com_google_android_gms_fonts_certs">
        <item>@array/com_google_android_gms_fonts_certs_dev</item>
        <item>@array/com_google_android_gms_fonts_certs_prod</item>
    </array>
    <string-array name="com_google_android_gms_fonts_certs_dev">
        <item>
            
        </item>
    </string-array>
    <string-array name="com_google_android_gms_fonts_certs_prod">
        <item>
            
        </item>
    </string-array>
</resources>
